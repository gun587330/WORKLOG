# ── 루트 .env (서버 · 스크립트 전용, 커밋 금지) ──
# Supabase 프로젝트 대시보드 > Settings > API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service_role key — 프론트 · 커밋 어디에도 넣지 않는다>

# scripts/create-owner.mjs — 본인 계정 생성 (비밀번호는 인자가 아니라 환경 변수로만)
OWNER_EMAIL=you@example.com
OWNER_PASSWORD=<10자 이상, 대소문자 + 숫자>
OWNER_NAME=정건
